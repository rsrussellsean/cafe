# ─────────────────────────────────────────────────────────────
# n8n automation webhooks.
#
# Server-side only — never prefix these with NEXT_PUBLIC_. They are read in
# lib/n8n/env.ts, which runs exclusively inside the /api route handlers, so the
# URLs never reach the browser bundle.
#
# If a variable is unset the matching feature fails closed with a friendly
# "temporarily unavailable" message; there is no hard-coded fallback URL.
# ─────────────────────────────────────────────────────────────

N8N_RESERVATION_WEBHOOK_URL=https://n8n-latest-xde2.onrender.com/webhook/reserve-table
N8N_GRABFOOD_WEBHOOK_URL=https://n8n-latest-xde2.onrender.com/webhook/order-grabfood
N8N_FOODPANDA_WEBHOOK_URL=https://n8n-latest-xde2.onrender.com/webhook/order-foodpanda

# Outbound timeout in ms. The n8n instance is on Render's free tier and
# cold-starts, so keep this generous. Default: 10000.
N8N_TIMEOUT_MS=10000
